# PostgreSQL
DATABASE_URL="postgresql://erp:erp@localhost:5432/erp?schema=public"
# Produção com pooler (ex.: Neon): DATABASE_URL = URL "pooled"; esta = URL direta (usada só nas migrations)
DIRECT_DATABASE_URL=""

# Auth.js — gere com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-forte"

# Asaas
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
# Token configurado no painel do Asaas para autenticar webhooks
ASAAS_WEBHOOK_TOKEN=""

# URL pública do app (links de convite). Se vazio, usa o host da requisição.
APP_URL="http://localhost:3000"

# E-mail transacional (convites e recuperação de senha). Sem chave, convites geram link para copiar
# e, em desenvolvimento, o link de recuperação de senha aparece no log do servidor.
RESEND_API_KEY=""
EMAIL_FROM="Meu ERP <nao-responda@seudominio.com.br>"
